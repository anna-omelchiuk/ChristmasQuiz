<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChristmasQuiz</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="christmas-header">
        <div class="header-content">
            <h1>Різдвяна Вікторина</h1>
        </div>
    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="christmas-footer">
        <div>
            &copy; 2026 - ChristmasQuiz - <a asp-controller="Quiz" asp-action="Index">Головна</a>
        </div>
    </footer>
</body>
</html>
