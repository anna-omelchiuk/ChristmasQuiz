@model ChristmasQuiz.Models.QuestionItem
@{
    ViewData["Title"] = $"Питання {ViewBag.CurrentIndex + 1}";
    int current = ViewBag.CurrentIndex + 1;
    int total = ViewBag.TotalQuestions;
    int progress = (int)((double)current / total * 100);
}

<div class="quiz-card">
    <div class="quiz-topbar">
        <span class="user-badge">Учасник: <strong>@ViewBag.UserName</strong></span>
        <span class="step-badge">Питання <strong>@current</strong> з <strong>@total</strong></span>
    </div>

    <div class="progress-bar-container">
        <div class="progress-bar-fill" style="width: @(progress)%;"></div>
    </div>

    <h3 class="question-title">@Model.Text</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert-error">@ViewBag.Error</div>
    }

    <form asp-action="Question" asp-controller="Quiz" method="post">
        <input type="hidden" name="sessionId" value="@ViewBag.SessionId" />
        <input type="hidden" name="index" value="@ViewBag.CurrentIndex" />

        <div class="options-list">
            @for (int i = 0; i < Model.Options.Count; i++)
            {
                <label class="option-label">
                    <input type="radio" name="selectedOption" value="@i" class="option-radio" />
                    <span class="option-text">@Model.Options[i]</span>
                </label>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                @(current == total ? "Завершити тест і надіслати на пошту" : "Наступне питання")
            </button>
        </div>
    </form>
</div>